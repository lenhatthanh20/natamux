---
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import NativeClip from '../components/NativeClip.astro'
import '../styles/landing.css'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const version = '1.0.23'
const repo = 'https://github.com/lenhatthanh20/natamux'
const docs = `${base}docs/`
const site = 'https://natamux.github.io'
const installSh = `curl -fsSL ${site}/install.sh | sh`
const installPs1 = `irm ${site}/install.ps1 | iex`
const title = 'Natamux: from task to shipped change'
const description =
  'Run coding agents in parallel, with a worktree for every task. Shape the stages, checks and approvals in one visible workflow. Open source, local first, for macOS, Windows and Linux.'

const workflow = [
  { step: '01 / Start', title: 'Give the task context', text: 'Add notes, a GitHub issue, a skill or files. Natamux creates a worktree and a branch for the task.' },
  { step: '02 / Run', title: 'Agents work in stages', text: 'Choose the agent for each stage. Test spec and Implement can run side by side, each in its own terminal.' },
  { step: '03 / Decide', title: 'Review at the gate', text: 'Read the result, answer a question, approve the stage or send it back with the reason.' },
  { step: '04 / Ship', title: 'Read the change', text: 'Inspect the diff, commit, push and open a pull request. Follow its checks from the task.' },
]
const features = [
  {
    name: 'status', label: 'Status', title: 'Who needs you now?',
    text: 'Questions and review gates surface in the sidebar. Running tasks keep their stage and latest activity in sight.',
    description: 'Task status and a question in the native workspace',
    caption: 'Find a task that needs your answer and return to its workspace.',
    link: 'guides/dashboard/', linkLabel: 'Read the dashboard',
  },
  {
    name: 'progress-wide', label: 'Progress', title: 'Follow every stage.',
    text: 'See where each task is, which path it took and what runs next. Approve a stage where the workflow waits for you.',
    description: 'A real native workspace with running terminals and its workflow Progress view',
    caption: 'Follow the task through its stages and review the next decision.',
    link: 'concepts/stages/', linkLabel: 'Stages and gates',
  },
  {
    name: 'review', label: 'Review', title: 'Keep the diff close.',
    text: 'Read inline or side-by-side diffs. Send a line comment to the agent, then commit and open a pull request from the task.',
    description: 'A task diff and its review actions in the native Changes view',
    caption: 'Read the changes beside the task and send feedback to its agent.',
    link: 'guides/changes-and-history/', linkLabel: 'Changes and history',
  },
]
const buildingBlocks = [
  { number: '01', title: 'Stages and gates', text: 'Choose each step and where it waits for your approval.', link: 'concepts/stages/#gates' },
  { number: '02', title: 'Side by side', text: 'Run 2 to 4 stages at once, each in its own shell.', link: 'concepts/stages/#stages-that-run-side-by-side' },
  { number: '03', title: 'Branches', text: 'Pick a path from a file condition or a command result.', link: 'concepts/stages/#paths-with-a-condition' },
  { number: '04', title: 'Send back', text: 'Return work to an earlier stage with the reason.', link: 'concepts/review-loop/' },
  { number: '05', title: 'CI as a stage', text: 'Run checks on a snapshot and send a failed log to the agent.', link: 'concepts/stages/#check-a-stage-on-ci' },
  { number: '06', title: 'An agent per stage', text: 'Set the agent and its model for each step in the file.', link: 'guides/mix-agents/' },
]
const useCases = [
  { number: '01', title: 'Simple projects', text: 'Make a small change, update the docs or build a personal website.', anchor: 'first-small-change' },
  { number: '02', title: 'Solo work', text: 'Fix a bug, compare agent attempts or ask another agent to review.', anchor: 'independent-review' },
  { number: '03', title: 'Teams', text: 'Plan tests beside implementation, route tasks and retry failed CI.', anchor: 'parallel-test-planning' },
  { number: '04', title: 'Larger organizations', text: 'Share project settings and keep human decisions at clear gates.', anchor: 'shared-settings-and-human-approvals' },
]
const agents = [
  { name: 'Claude Code', command: 'claude', link: 'agents/claude-code/' },
  { name: 'Codex', command: 'codex', link: 'agents/codex/' },
  { name: 'Gemini CLI', command: 'gemini', link: 'agents/gemini/' },
  { name: 'GitHub Copilot CLI', command: 'copilot', link: 'agents/copilot/' },
  { name: 'Cursor', command: 'cursor-agent', link: 'agents/cursor/' },
  { name: 'Other terminal agents', command: 'your-agent', link: 'agents/other-agents/' },
]
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}${base}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Natamux" />
    <meta property="og:url" content={`${site}${base}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site}${base}media/native/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The native Natamux workspace with scripted demo terminals and parallel workflow stages." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}${base}media/native/og.jpg`} />
    <meta name="theme-color" content="#11151b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)" />
    <link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('starlight-theme')
        const light = saved === 'light' || (saved !== 'dark' && matchMedia('(prefers-color-scheme: light)').matches)
        document.documentElement.dataset.theme = light ? 'light' : 'dark'
      } catch {
        document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header"><SiteHeader /></header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">A system you can read at a glance.</p>
            <h1 id="hero-title">From task to shipped change. <em>One visible system.</em></h1>
            <p class="lede">Set the path once. Agents run the stages, checks and reviews. See every handoff, question and decision as the work happens.</p>
            <div class="ctas">
              <a class="btn primary big" href="#download" data-hero-download><span data-hero-label>Install on macOS</span><span aria-hidden="true">↗</span></a>
              <a class="btn big" href={docs}>Read the docs</a>
              <a class="btn big" href={`${docs}guides/use-cases/`}>Use cases</a>
            </div>
            <p class="fine"><span data-hero-note data-version={version}>Version {version} for Apple silicon.</span> <a href="#download">Other systems</a>.</p>
            <p class="hero-note">Open source · Local first · No account</p>
          </div>
          <div class="hero-visual">
            <p class="visual-label">The workspace / 01</p>
            <div class="visual-head"><span>ONE TASK / ONE WORKSPACE</span><strong>Natamux native app</strong></div>
            <NativeClip name="hero" description="A task, its agent terminal and the next decision in the native workspace" caption="The task, terminal and next action stay together in one workspace." />
          </div>
        </div>
      </section>

      <div class="trust-line">
        <div class="wrap trust-inner"><strong>One place for the whole task</strong><span>Worktree per task</span><span>Status from hooks</span><span>Approvals and review</span><span>Git and pull requests</span></div>
      </div>

      <section class="section" id="workflow" aria-labelledby="workflow-title">
        <div class="wrap">
          <div class="section-head">
            <div><p class="section-kicker">01 / Workflow</p><h2 id="workflow-title">Every task has a path.</h2></div>
            <p>Start with the default stages, or shape the process in <b>Project settings → Stages</b>. Commit <code>.natamux.json</code> to share the same workflow with your team.</p>
          </div>
          <ol class="workflow">{workflow.map((step) => <li><span class="step-num">{step.step}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
          <p class="more"><a href={`${docs}getting-started/quick-start/`}>Start with one task <span aria-hidden="true">↗</span></a></p>
        </div>
      </section>

      <section class="section" id="features" aria-labelledby="features-title">
        <div class="wrap">
          <div class="section-head">
            <div><p class="section-kicker">02 / The app</p><h2 id="features-title">See the work, keep the context.</h2></div>
            <p>Keep the state of each task in view, follow its progress and review the change from the same workspace.</p>
          </div>
          <div class="feature-grid">
            {features.map((feature) => (
              <article class="feature-card">
                <div class="feature-copy"><p class="section-kicker">{feature.label}</p><h3>{feature.title}</h3><p>{feature.text}</p></div>
                <NativeClip name={feature.name} description={feature.description} caption={feature.caption} />
                <a class="feature-link" href={`${docs}${feature.link}`}>{feature.linkLabel} <span aria-hidden="true">↗</span></a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="workflows" aria-labelledby="workflows-title">
        <div class="wrap">
          <div class="section-head">
            <div><p class="section-kicker">03 / Make it yours</p><h2 id="workflows-title">Shape the path around the work.</h2></div>
            <p>Start with a short solo flow. Add review rules as you need them. Arrange these building blocks in the app, or edit the same project file.</p>
          </div>
          <div class="workflow-detail">
            <div class="blocks-grid">{buildingBlocks.map((block) => <a class="building-block" href={`${docs}${block.link}`}><span>{block.number}</span><div><h3>{block.title}</h3><p>{block.text}</p></div><span aria-hidden="true">↗</span></a>)}</div>
            <NativeClip name="settings" description="Project settings and the workflow stage editor in the native app" caption="Edit the workflow in Project settings and share it through .natamux.json." />
          </div>
          <p class="more"><a href={`${docs}guides/use-cases/`}>Find a use case for your project <span aria-hidden="true">↗</span></a></p>
          <div class="blocks-grid">{useCases.map((useCase) => <a class="building-block" href={`${docs}guides/use-cases/#${useCase.anchor}`}><span>{useCase.number}</span><div><h3>{useCase.title}</h3><p>{useCase.text}</p></div><span aria-hidden="true">↗</span></a>)}</div>
          <p class="more"><a href={`${docs}guides/workflows/`}>Build a workflow step by step <span aria-hidden="true">↗</span></a></p>
        </div>
      </section>

      <section class="section" id="agents" aria-labelledby="agents-title">
        <div class="wrap agents-row">
          <div class="agents-copy"><p class="section-kicker">04 / Your agents</p><h2 id="agents-title">Bring the tools you already use.</h2><p>Natamux starts the agent in the task's terminal. Hooks report when it works, asks or finishes. Give each stage its own agent and model.</p><p>A plain terminal agent works too. Its bell, <code>natamux ask</code> and <code>natamux done</code> report back.</p><p class="more"><a href={`${docs}concepts/agents-and-hooks/`}>How agent status works <span aria-hidden="true">↗</span></a></p></div>
          <ul class="agents-list">{agents.map((agent) => <li><a href={`${docs}${agent.link}`}><strong>{agent.name}</strong><code>{agent.command}</code><span aria-hidden="true">↗</span></a></li>)}</ul>
        </div>
      </section>

      <section class="section" id="project" aria-labelledby="project-title">
        <div class="wrap project-row">
          <div><p class="section-kicker">05 / Your project</p><h2 id="project-title">Fits the project you already have.</h2><p class="sub">Your repository, your tools, your agent logins.</p><ul class="ticks"><li>A separate worktree and branch for every task.</li><li><code>.natamux-setup</code> prepares each new workspace. On Windows, use <code>.natamux-setup.ps1</code>.</li><li>Ten ports per task, with the first in <code>$PORT</code>.</li><li>Checks and conditions can run any shell command.</li><li><b>Export</b> a workflow and <b>Import...</b> it into another project. Import lists its commands first.</li></ul><p class="more"><a href={`${docs}concepts/workspaces/`}>Workspaces <span aria-hidden="true">↗</span></a></p></div>
          <div class="project-tools">
            <NativeClip name="editor" description="A task file opened and edited in the native file editor" caption="Open a file from the task's worktree and edit it beside the agent's work." />
            <div class="cli-card"><div class="code-title"><span>YOU + YOUR AGENTS</span><code>natamux / nmx</code></div><pre><span class="code-comment"># Start a task</span>
nmx task create "Export the report as CSV"
nmx agent start T-0010 --agent codex

<span class="code-comment"># Ask a question, then report done</span>
natamux ask "Keep the old CSV columns?"
natamux done

<span class="code-comment"># Send findings back to Implement</span>
natamux stage back $NATAMUX_TASK_ID \
  --to implement --reason "Empty rows break the export"</pre><a class="feature-link" href={`${docs}reference/cli/`}>CLI reference <span aria-hidden="true">↗</span></a></div>
          </div>
        </div>
      </section>

      <section class="section privacy" aria-labelledby="privacy-title">
        <div class="wrap privacy-row"><div><p class="section-kicker">Local first</p><h2 id="privacy-title">Your workspace stays yours.</h2></div><ul><li><b>No Natamux account or telemetry.</b> Task files and their history live on your machine. Your agents use their own services and logins.</li><li><b>A local daemon.</b> It listens on <code>127.0.0.1</code> and requires a token on every request.</li><li><b>Open source.</b> GPL-3.0 licensed. Besides update checks, Natamux talks to GitHub through your own <code>git</code> and <code>gh</code>.</li></ul></div>
      </section>

      <section class="section download" id="download" aria-labelledby="download-title">
        <div class="wrap">
          <div class="head download-head">
            <p class="section-kicker">06 / Get started</p>
            <h2 id="download-title">Download Natamux {version}</h2>
            <p>
              You need git and at least one agent, installed and signed in. The GitHub CLI adds pull requests and
              issues.
            </p>
          </div>

          <div class="dl" data-tabs data-dl>
            <div class="dl-tabs" role="tablist" aria-label="Operating system">
              <button type="button" role="tab" id="tab-mac" aria-controls="panel-mac" aria-selected="true" tabindex="0">macOS</button>
              <button type="button" role="tab" id="tab-win" aria-controls="panel-win" aria-selected="false" tabindex="-1">Windows</button>
              <button type="button" role="tab" id="tab-linux" aria-controls="panel-linux" aria-selected="false" tabindex="-1">Linux</button>
            </div>
            <p class="dl-detect" data-dl-detect hidden></p>
            <div class="stack">
              <div class="dl-panel" role="tabpanel" id="panel-mac" aria-labelledby="tab-mac" data-active="true">
                <p class="dl-label">Install with one command, in Terminal</p>
                <div class="cmd"><code>{installSh}</code><button type="button" data-copy>Copy</button></div>
                <p class="dl-note">It installs Natamux in Applications, checks the file and lets macOS open it the first time.</p>
              </div>
              <div class="dl-panel" role="tabpanel" id="panel-win" aria-labelledby="tab-win" data-active="false">
                <p class="dl-label">Install with one command, in PowerShell</p>
                <div class="cmd"><code>{installPs1}</code><button type="button" data-copy>Copy</button></div>
                <p class="dl-note">It checks the installer and runs it for your user, with no administrator rights.</p>
              </div>
              <div class="dl-panel" role="tabpanel" id="panel-linux" aria-labelledby="tab-linux" data-active="false">
                <p class="dl-label">Debian and Ubuntu: install with one command</p>
                <div class="cmd"><code>{installSh}</code><button type="button" data-copy>Copy</button></div>
                <p class="dl-note">It checks the <code>.deb</code> and installs it with apt. On other distributions, <a href={`${base}download/`}>download the AppImage</a>.</p>
              </div>
            </div>
          </div>

          <ul class="dl-links dl-more">
            <li><a href={`${base}download/`}>Download a file instead</a>: <code>.dmg</code>, <code>.exe</code>, AppImage, <code>.deb</code> and <code>.tar.gz</code></li>
            <li><a href={`${docs}getting-started/install/`}>Install guide</a>, with what the command does</li>
            <li><a href={`${repo}/releases/tag/v${version}`}>Release notes of {version}</a> and <a href={`${docs}help/changelog/`}>the changelog</a></li>
            <li><a href={`${docs}guides/self-host-docker/`}>Run with Docker</a> or build the Rust images in a Codespace</li>
          </ul>
        </div>
      </section>
    </main>

    <SiteFooter />

    <script>
      import '../scripts/signal-flow.js'
    </script>
  </body>
</html>
