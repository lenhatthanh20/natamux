---
// The landing page. The docs live under /docs/ (Starlight).
import '../styles/landing.css'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const version = '0.1.18'
const repo = 'https://github.com/lenhatthanh20/natamux'
// The file name carries no version, so this link always gets the newest release.
const mac = `${repo}/releases/latest/download/Natamux-mac-arm64.dmg`
const docs = `${base}docs/`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Natamux: run many coding agents, see them in one place</title>
    <meta
      name="description"
      content="Run Claude Code, Codex, Gemini CLI, Copilot CLI and Cursor in parallel. Every task gets its own git worktree, terminal and stages, and one dashboard tells you which task needs you."
    />
    <meta property="og:title" content="Natamux" />
    <meta property="og:description" content="Run many coding agents in parallel, on one dashboard." />
    <meta property="og:image" content={`https://natamux.github.io${base}media/demo-poster.jpg`} />
    <meta name="theme-color" content="#060a14" />
    <link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400..600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav" data-nav>
      <div class="wrap">
        <a class="brand" href={base}>
          <img src={`${base}icon.svg`} alt="" width="28" height="28" />
          <span>Natamux</span>
        </a>
        <nav aria-label="Main">
          <a href="#features">Features</a>
          <a href="#stages">Stages</a>
          <a href="#cli">CLI</a>
          <a href={docs}>Docs</a>
          <a href={`${docs}help/changelog/`}>Changelog</a>
        </nav>
        <div class="end">
          <a class="btn" href={repo} aria-label="Natamux on GitHub">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z" /></svg>
            GitHub
          </a>
          <a class="btn primary" href={mac}>Download</a>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="grid-bg" aria-hidden="true"></div>
        <div class="wrap hero-copy">
          <a class="news" href={`${docs}concepts/stages/#review-by-an-agent`}>
            <b>v{version}</b> An agent reviews the work and sends it back
          </a>
          <h1 id="hero-title">
            <span class="line">Five agents at work.</span>
            <span class="line soft">One place to see them.</span>
          </h1>
          <p class="lede">
            Natamux gives every task its own <b>git worktree, terminal and stages</b>. Claude Code, Codex,
            Gemini, Copilot and Cursor work side by side, and the dashboard tells you the one task that
            needs you.
          </p>
          <div class="ctas">
            <a class="btn primary big" href={mac} data-download>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.37 12.78c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.77-3.32-1.8-1.41-.14-2.76.83-3.48.83-.72 0-1.82-.81-3-.79-1.54.02-2.96.9-3.76 2.27-1.6 2.78-.41 6.9 1.15 9.16.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.24-.02 2.02-1.12 2.77-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.4-.92-2.42-3.66ZM14.1 6.03c.63-.77 1.06-1.83.94-2.9-.91.04-2.02.61-2.67 1.37-.58.67-1.1 1.76-.96 2.8 1.02.08 2.06-.52 2.69-1.27Z" /></svg>
              Download for macOS
            </a>
            <a class="btn big" href={`${docs}getting-started/quick-start/`}>Read the quick start</a>
          </div>
          <p class="fine">
            Version {version} for Apple silicon. Free and open source under MIT. No account, no telemetry.
          </p>
        </div>

        <div class="wrap merge" aria-hidden="true">
          <svg viewBox="0 0 1200 150" preserveAspectRatio="none">
            <path class="lane amber" d="M120 0 C 120 90, 600 60, 600 150" />
            <path class="lane sky" d="M600 0 L 600 150" />
            <path class="lane mint" d="M1080 0 C 1080 90, 600 60, 600 150" />
            <path class="flow amber" pathLength="1000" d="M120 0 C 120 90, 600 60, 600 150" />
            <path class="flow sky b" pathLength="1000" d="M600 0 L 600 150" />
            <path class="flow mint c" pathLength="1000" d="M1080 0 C 1080 90, 600 60, 600 150" />
          </svg>
        </div>

        <div class="wrap shot reveal in">
          <div class="fit" data-fit>
            <div
              class="app"
              data-hero
              role="img"
              aria-label="The Natamux dashboard. A Claude Code task runs its Implement stage, the Progress panel moves to Review, another task asks a question and shows up under Needs you."
            >
              <div class="a-title">
                <div class="lights"><i></i><i></i><i></i></div>
                <div class="a-crumb"><b>Natamux</b><span>|</span>natamux / <span class="mono">T-0012</span> Command palette with ⌘K</div>
                <div class="a-search">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                  Search or run a command <kbd>⌘K</kbd>
                </div>
                <span class="pill-needs" data-h-pill>1 needs you</span>
              </div>

              <div class="a-body">
                <aside class="a-side">
                  <div class="a-filter">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M7 12h10M10 18h4" /></svg>
                    Filter tasks <span class="kbd">/</span>
                  </div>
                  <div class="a-nav"><span>All tasks</span><span>12</span></div>
                  <div class="a-nav"><span>Agents</span><span>4</span></div>

                  <div class="needs-box" data-h-needsbox>
                    <div class="a-head">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.94 1.94 0 0 0 3.4 0" /></svg>
                      NEEDS YOU <span class="a-count" data-h-count>1</span>
                    </div>
                    <div data-h-needs>
                      <div class="needs-row">
                        <i class="g" data-s="failed"></i><span class="t">Retry pushes on network errors</span><span class="ago">4m</span>
                        <span class="why">Testing · 2 tests failed</span>
                      </div>
                    </div>
                  </div>

                  <div class="a-head">WORKSPACES</div>
                  <div class="a-nav"><span>▾ natamux</span><span class="a-count">6</span></div>
                  <div class="ws on">
                    <i class="g" data-s="running" data-h-glyph></i><span class="t">Command palette with ⌘K</span><span class="ago">now</span>
                    <span class="act" data-h-act>Read src/components/CommandPalette.tsx</span>
                  </div>
                  <div class="ws">
                    <i class="g" data-s="running"></i><span class="t">Drag tasks between columns</span><span class="ago">now</span>
                    <span class="act" data-h-act2>Bash: pnpm --filter web test</span>
                  </div>
                  <div class="ws" data-h-ask>
                    <i class="g" data-s="running"></i><span class="t">Fix the token refresh race</span><span class="ago">1m</span>
                    <span class="act">ReadFile src/auth/refresh.ts</span>
                  </div>
                  <div class="ws">
                    <i class="g" data-s="review"></i><span class="t">CSV export for the task table</span><span class="ago">12m</span>
                    <span class="sub">csv-export-for-the-task-table</span>
                  </div>
                  <div class="ws">
                    <i class="g" data-s="blocked"></i><span class="t">Windows path tests</span><span class="ago">1h</span>
                    <span class="sub">windows-path-tests</span>
                  </div>
                  <div class="a-nav" style="color: var(--a-faint)"><span>› 5 finished</span></div>
                </aside>

                <div class="a-main">
                  <div class="a-wshead">
                    <span class="id mono">T-0012</span>
                    <h4>Command palette with ⌘K</h4>
                    <span class="badge" data-s="running" data-h-badge>Running</span>
                    <span class="chip-branch">natamux/t-0012-command-palette</span>
                    <span class="end">
                      <span class="a-btn">↑ Push</span>
                      <span class="a-btn pri" data-h-pr>Create pull request</span>
                    </span>
                  </div>
                  <div class="a-tabs">
                    <span class="on">Terminal</span><span>Changes <span class="a-count" data-h-changes>3</span></span><span>History</span><span>Docs</span>
                    <span class="end">+ New shell</span>
                  </div>
                  <div class="review-bar" data-h-review>
                    <i class="g" data-s="review"></i>
                    <span><b>Ready for review:</b> Test spec and Implement</span>
                    <span class="end">
                      <span class="a-btn">Send back</span>
                      <span class="a-btn pri" data-h-approve>Approve <span class="kbd">⌘↵</span></span>
                    </span>
                  </div>
                  <div class="term">
                    <div class="term-head">
                      <i class="g" data-s="running" data-h-tglyph></i>
                      <span class="mono">T-0012</span> Implement <span class="agent-name">· Claude Code</span>
                      <span class="end" data-h-tstate>Running · Read src/components/CommandPalette.tsx</span>
                    </div>
                    <div class="term-body" data-h-term></div>
                  </div>
                </div>

                <aside class="a-detail">
                  <h5><span>Progress</span><span style="color: var(--a-faint)">Details</span></h5>
                  <div class="a-card">
                    <b data-h-done>3 of 7</b> stages done · <b>18m</b> since the task started
                  </div>
                  <ol class="stages" data-h-stages>
                    <li class="done"><span class="m"></span><span class="n">Context</span><span class="when">1m</span><span class="note">context.md</span></li>
                    <li class="done"><span class="m"></span><span class="n">Spec</span><span class="when">4m</span><span class="note">Approved by you</span></li>
                    <li class="done"><span class="m"></span><span class="n">Plan</span><span class="when">6m</span><span class="note">plan.md</span></li>
                    <li class="run side" data-st="test"><span class="m"></span><span class="n">Test spec</span><span class="when"></span><span class="note">test-spec.md · side by side with Implement</span></li>
                    <li class="run" data-st="impl">
                      <span class="m"></span><span class="n">Implement</span><span class="when"></span>
                      <span class="wf"><span class="switch on"></span>Run with a workflow</span>
                    </li>
                    <li data-st="review"><span class="m"></span><span class="n">Review</span><span class="when"></span><span class="note">you approve</span></li>
                    <li data-st="testing"><span class="m"></span><span class="n">Testing</span><span class="when"></span><span class="note">pnpm test must pass</span></li>
                    <li data-st="release"><span class="m"></span><span class="n">Release</span><span class="when"></span><span class="note">Opens the pull request</span></li>
                  </ol>
                </aside>
              </div>

              <div class="a-status">
                <span class="live">Live</span><span data-h-running>3 running</span><span class="n" data-h-need>1 need you</span>
                <span class="end"><span>Projects</span><span>Import issues</span><span>Notify me</span></span>
              </div>

              <div class="toast" data-h-toast>
                <i class="g" data-s="done"></i><b data-h-toast-title>Pull request opened</b><span data-h-toast-text>natamux#182 · Command palette with ⌘K</span>
              </div>
              <svg class="pointer" data-h-pointer viewBox="0 0 18 22" aria-hidden="true"><path d="M1 1v17l4.5-4.2 3 6.7 3-1.4-3-6.5H15Z" fill="#fff" stroke="#000" stroke-width="1.2" stroke-linejoin="round" /></svg>
            </div>
          </div>
        </div>
      </section>

      <section class="wrap agents reveal" aria-label="Agents">
        <p>Works with the agents you already use</p>
        <ul>
          <li><i style="--c: #e8916b"></i>Claude Code</li>
          <li><i style="--c: #e6e7ea"></i>Codex</li>
          <li><i style="--c: #7fa8ff"></i>Gemini CLI</li>
          <li><i style="--c: #b39cff"></i>Copilot CLI</li>
          <li><i style="--c: #58d3a6"></i>Cursor</li>
        </ul>
      </section>

      <section class="section" id="features" aria-labelledby="features-title">
        <div class="wrap">
          <div class="section-head center reveal">
            <h2 id="features-title">Run them all. Answer only when asked.</h2>
            <p>
              Agents report their state through hooks, so the dashboard knows who is working, who is
              stuck and who is done, within a second.
            </p>
          </div>

          <div class="show-tabs reveal" role="tablist" aria-label="Features" data-show>
            <button role="tab" id="tab-needs" aria-controls="panel-needs" aria-selected="true">Needs you<span class="bar"></span></button>
            <button role="tab" id="tab-progress" aria-controls="panel-progress" aria-selected="false" tabindex="-1">Progress<span class="bar"></span></button>
            <button role="tab" id="tab-stages" aria-controls="panel-stages" aria-selected="false" tabindex="-1">Project stages<span class="bar"></span></button>
            <button role="tab" id="tab-agents" aria-controls="panel-agents" aria-selected="false" tabindex="-1">Agents grid<span class="bar"></span></button>
            <button role="tab" id="tab-review" aria-controls="panel-review" aria-selected="false" tabindex="-1">Review<span class="bar"></span></button>
          </div>

          <div class="panel" role="tabpanel" id="panel-needs" aria-labelledby="tab-needs" style="--lane: var(--amber)">
            <div class="copy">
              <h3>The one task that needs you comes to the top</h3>
              <p>A question, a failed check, a stage that waits for your approval: it goes into <b>Needs you</b>, with the reason in plain words.</p>
              <ul>
                <li>An amber pill in the title bar counts what waits for you</li>
                <li>A desktop notice, even when the window is closed</li>
                <li>Answer in the task's own terminal, then the agent goes on</li>
              </ul>
            </div>
            <div class="shot">
              <div class="fit" data-fit>
                <div class="app" data-demo="needs" role="img" aria-label="Tasks move into the Needs you list one by one, and a desktop notice shows the question of an agent.">
                  <div class="a-body" style="grid-template-columns: 300px 1fr">
                    <aside class="a-side" style="padding: 14px 12px">
                      <div class="a-filter">Filter tasks <span class="kbd">/</span></div>
                      <div class="needs-box glow">
                        <div class="a-head">NEEDS YOU <span class="a-count" data-n-count>0</span></div>
                        <div data-n-list><div class="needs-empty">Nothing needs you</div></div>
                      </div>
                      <div class="a-head">WORKSPACES</div>
                      <div class="ws"><i class="g" data-s="running" data-n-g="0"></i><span class="t">Fix the token refresh race</span><span class="ago">now</span><span class="act" data-n-a="0">ReadFile src/auth/refresh.ts</span></div>
                      <div class="ws"><i class="g" data-s="running" data-n-g="1"></i><span class="t">CSV export for the task table</span><span class="ago">now</span><span class="act" data-n-a="1">Edit src/export/csv.ts</span></div>
                      <div class="ws"><i class="g" data-s="running" data-n-g="2"></i><span class="t">Retry pushes on network errors</span><span class="ago">now</span><span class="act" data-n-a="2">Bash: pnpm test</span></div>
                      <div class="ws"><i class="g" data-s="running"></i><span class="t">Drag tasks between columns</span><span class="ago">now</span><span class="act">apply_patch Board.tsx</span></div>
                    </aside>
                    <div class="a-main" style="grid-template-rows: auto 1fr">
                      <div class="a-wshead"><span class="id mono">T-0004</span><h4>Fix the token refresh race</h4><span class="badge" data-s="running" data-n-badge>Running</span></div>
                      <div class="term" style="margin-top: 0">
                        <div class="term-head"><span class="mono">T-0004</span> Spec <span class="agent-name">· Gemini CLI</span></div>
                        <div class="term-body" data-n-term></div>
                      </div>
                    </div>
                  </div>
                  <div class="notif" data-n-notif>
                    <img src={`${base}icon.svg`} alt="" width="34" height="34" />
                    <b>Natamux</b><small>now</small>
                    <span>T-0004 asks: Keep the old ticket format for one release?</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="panel" role="tabpanel" id="panel-progress" aria-labelledby="tab-progress" style="--lane: var(--sky)" hidden>
            <div class="copy">
              <h3>Every task, every stage, on one screen</h3>
              <p>The <b>Progress</b> view puts each task on a row and each stage in a column. You see what moved, what waits and what failed.</p>
              <ul>
                <li>Tasks that wait for you come first</li>
                <li>One click: Answer, Review or Open</li>
                <li>The details panel shows time per stage, checks and the files each stage wrote</li>
              </ul>
            </div>
            <div class="shot">
              <div class="fit" data-fit>
                <div class="app" data-demo="progress" role="img" aria-label="A table of tasks and stages. Markers turn green as stages finish.">
                  <div class="pb" data-p-board></div>
                </div>
              </div>
            </div>
          </div>

          <div class="panel" role="tabpanel" id="panel-stages" aria-labelledby="tab-stages" style="--lane: var(--mint)" hidden>
            <div class="copy">
              <h3>Your pipeline, per project</h3>
              <p>In <b>Project settings → Stages</b>, pick from a catalog of 27 steps, turn stages off, reorder them, run two side by side, and write your own prompts.</p>
              <ul>
                <li><b>Wait for my approval</b> on any stage</li>
                <li><b>Insert skill</b> puts a skill in the prompt for any agent</li>
                <li>Saved in <code>.natamux.json</code>, so the team shares it</li>
              </ul>
            </div>
            <div class="shot">
              <div class="fit" data-fit>
                <div class="app" data-demo="stages" role="img" aria-label="Project settings. A Security review stage is added from the catalog, and the flow chart updates.">
                  <div class="ps">
                    <div class="ps-list" data-s-list>
                      <div class="ps-title"><b>Project settings of natamux</b><span class="a-btn pri">Save <span class="kbd">⌘↵</span></span></div>
                      <div class="ps-tabs"><span class="on">Stages</span><span>JSON</span></div>
                    </div>
                    <div class="flowchart" data-s-flow><h6>Pipeline</h6></div>
                  </div>
                  <div class="catalog" data-s-catalog>
                    <div class="q">Search stages</div>
                    <div><span>Lint and types</span><small>Check</small></div>
                    <div data-s-pick><span>Security review</span><small>Check</small></div>
                    <div><span>Accessibility check</span><small>Check</small></div>
                    <div><span>Manual QA</span><small>Check</small></div>
                  </div>
                  <svg class="pointer" data-s-pointer viewBox="0 0 18 22" aria-hidden="true"><path d="M1 1v17l4.5-4.2 3 6.7 3-1.4-3-6.5H15Z" fill="#fff" stroke="#000" stroke-width="1.2" stroke-linejoin="round" /></svg>
                </div>
              </div>
            </div>
          </div>

          <div class="panel" role="tabpanel" id="panel-agents" aria-labelledby="tab-agents" style="--lane: var(--violet)" hidden>
            <div class="copy">
              <h3>Four agents, four worktrees, one grid</h3>
              <p>The <b>Agents</b> view puts live terminals side by side. Each runs in its own worktree on its own branch, so no agent edits another's files.</p>
              <ul>
                <li>Real terminals, drawn on the GPU, with full scrollback</li>
                <li>A pane that waits for you gets an amber frame</li>
                <li>Type into any pane, or open its workspace</li>
              </ul>
            </div>
            <div class="shot">
              <div class="fit" data-fit>
                <div class="app" data-demo="agents" role="img" aria-label="Four terminals: Claude Code, Codex, Gemini CLI and Cursor work at the same time.">
                  <div class="grid4" data-g-grid></div>
                </div>
              </div>
            </div>
          </div>

          <div class="panel" role="tabpanel" id="panel-review" aria-labelledby="tab-review" style="--lane: var(--rose)" hidden>
            <div class="copy">
              <h3>Review the diff, then approve or send it back</h3>
              <p>When the agent is done, the task waits for you with its diff. <b>Approve</b> moves it on to Testing. <b>Send back</b> gives your note to the agent.</p>
              <ul>
                <li>Side-by-side diffs, images too</li>
                <li>Commit and push from the header</li>
                <li>Release opens the pull request when you click</li>
              </ul>
            </div>
            <div class="shot">
              <div class="fit" data-fit>
                <div class="app" data-demo="review" role="img" aria-label="A diff in the Changes tab, a review note, and the task sent back to the agent.">
                  <div class="rv">
                    <div>
                      <div class="a-wshead"><span class="id mono">T-0012</span><h4>Command palette with ⌘K</h4><span class="badge" data-s="review" data-r-badge>In review</span></div>
                      <div class="review-bar show" style="margin-bottom: 10px" data-r-bar>
                        <i class="g" data-s="review"></i><span><b>Ready for review:</b> Implement</span>
                        <span class="end"><span class="a-btn" data-r-back>Send back</span><span class="a-btn pri">Approve</span></span>
                      </div>
                    </div>
                    <div class="rv-body" style="border-top: 1px solid var(--a-line)">
                      <div class="rv-files">
                        <div class="on"><span>commands.ts</span><small><span class="a">+42</span> <span class="d">−3</span></small></div>
                        <div><span>CommandPalette.tsx</span><small><span class="a">+88</span> <span class="d">−12</span></small></div>
                        <div><span>palette.test.ts</span><small><span class="a">+61</span></small></div>
                      </div>
                      <div class="diff" data-r-diff>
                        <div class="hunk"><span></span><span></span><span>@@ -38,6 +38,12 @@ export const commands</span></div>
