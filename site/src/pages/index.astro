---
// The landing page. The docs live under /docs/ (Starlight).
import Shot from '../components/Shot.astro'
import '../styles/landing.css'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const version = '0.1.22'
const repo = 'https://github.com/lenhatthanh20/natamux'
const docs = `${base}docs/`
const site = 'https://natamux.github.io'
// File names carry no version, so these links always get the newest release.
const latest = (file: string) => `${repo}/releases/latest/download/${file}`
const mac = latest('Natamux-mac-arm64.dmg')

// The hero recording: where each step starts, in seconds. Both themes share the timing.
const heroSteps = [
  [0, 'Approve the spec'],
  [3, 'Two agents start'],
  [8.4, 'Review agent'],
  [15.7, 'Sent back'],
  [20.6, 'Review passes'],
] as const

const files = [
  { os: 'mac', label: 'macOS, Apple silicon (M1 and later)', file: 'Natamux-mac-arm64.dmg' },
  { os: 'mac', label: 'macOS, Intel', file: 'Natamux-mac-x64.dmg' },
  { os: 'win', label: 'Windows 10 and 11, x64', file: 'Natamux-win-x64.exe' },
  { os: 'linux', label: 'Linux, any distribution', file: 'Natamux-linux-x86_64.AppImage' },
  { os: 'linux', label: 'Debian and Ubuntu', file: 'Natamux-linux-amd64.deb' },
  { os: 'linux', label: 'Linux, no install', file: 'Natamux-linux-x64.tar.gz' },
]

// The default pipeline. x, y place a stage on the wide chart (1100 x 400),
// mx, my on the tall one for phones (360 x 710). The lane is the agent.
const stages = [
  { id: 'context', name: 'Context', sub: 'context.md', x: 66, y: 200, mx: 180, my: 45 },
  { id: 'spec', name: 'Spec', sub: 'spec.md', lane: 'amber', x: 227, y: 200, mx: 180, my: 140 },
  { id: 'plan', name: 'Plan', sub: 'plan.md', lane: 'amber', x: 389, y: 200, mx: 180, my: 235 },
  { id: 'impl', name: 'Implement', sub: 'code and tests', lane: 'amber', x: 550, y: 110, mx: 95, my: 345 },
  { id: 'test', name: 'Test spec', sub: 'test-spec.md', lane: 'mint', x: 550, y: 290, mx: 265, my: 345 },
  { id: 'tests', name: 'Automated tests', sub: 'a test per case', lane: 'amber', x: 711, y: 200, mx: 180, my: 455 },
  { id: 'review', name: 'Review', sub: 'review.md', lane: 'sky', x: 873, y: 200, mx: 180, my: 560 },
  { id: 'release', name: 'Release', sub: 'pull request', x: 1034, y: 200, mx: 180, my: 665 },
]

const edges = {
  wide: [
    ['e1', '', 'M128 200 H165'],
    ['e2', 'amber', 'M289 200 H327'],
    ['e3', 'amber', 'M451 200 C 480 200, 458 110, 488 110'],
    ['e4', 'mint', 'M451 200 C 480 200, 458 290, 488 290'],
    ['e5', 'amber', 'M612 110 C 642 110, 620 200, 649 200'],
    ['e6', 'mint', 'M612 290 C 642 290, 620 200, 649 200'],
    ['e7', 'sky', 'M773 200 H811'],
    ['e8', '', 'M935 200 H972'],
    ['loop', 'rose', 'M873 164 C 873 24, 550 24, 550 74 M543 64 L550 74 L557 64'],
  ],
  tall: [
    ['e1', '', 'M180 77 V108'],
    ['e2', 'amber', 'M180 172 V203'],
    ['e3', 'amber', 'M180 267 C 180 290, 95 290, 95 313'],
    ['e4', 'mint', 'M180 267 C 180 290, 265 290, 265 313'],
    ['e5', 'amber', 'M95 377 C 95 400, 180 400, 180 423'],
    ['e6', 'mint', 'M265 377 C 265 400, 180 400, 180 423'],
    ['e7', 'sky', 'M180 487 V528'],
    ['e8', '', 'M180 592 V633'],
    ['loop', 'rose', 'M105 560 C 8 560, 8 430, 40 377 M32 383 L40 377 L43 386'],
  ],
}

const steps = [
  {
    title: 'You approve the spec and the plan',
    text: 'The agent writes spec.md, then plan.md. Each one waits for your Approve, so nothing gets built from a plan you did not read.',
  },
  {
    title: 'Two agents start at once',
    text: 'Implement writes tests and code in Shell 1. Test spec starts a second agent in Shell 2 that works from the spec alone. You approve the test spec.',
  },
  {
    title: 'The tests run',
    text: 'An agent adds a test for each case of the test spec, runs every test and fixes what fails.',
  },
  {
    title: 'A third agent reviews',
    text: 'Review starts its own session in Shell 5 with the agent you pick in Project settings, such as Codex, and writes review.md.',
  },
  {
    title: 'Findings go back to Implement',
    text: 'The reviewer sends the task back with the reasons. Implement, the tests and Review run again. After two rounds it asks you.',
  },
  {
    title: 'Release opens the pull request',
    text: 'Natamux pushes the branch and opens the PR when you click. The task is done when the PR is merged.',
  },
]

const views = [
  {
    id: 'table',
    name: 'Table',
    text: 'Every task with its state, agent, branch and changes. Tasks that need you sort first, and / filters by id, title, agent, branch or label.',
    shot: 'table',
    alt: 'The All tasks table with ten tasks. One needs your input, three are in review, three are running, one is blocked.',
  },
  {
    id: 'board',
    name: 'Board',
    text: 'One column per state. Empty columns fold to a thin strip, so the work in flight stays in view.',
    shot: 'board-wide',
    alt: 'The board with columns for Needs your input, In review, Blocked, Running and Draft. Failed and Ready are folded.',
  },
  {
    id: 'palette',
    name: 'Command palette',
    text: 'Cmd+K or Ctrl+K finds any task or command. Tasks that need you come first, and Cmd+J jumps to a workspace.',
    shot: 'palette-actions',
    alt: 'The command palette open over a task. It lists tasks that need you, recent tasks and suggested commands.',
  },
  {
    id: 'start',
    name: 'Start a task',
    text: 'A title and the context: your notes, a GitHub issue, or an agent skill such as one that fetches a ticket. Attach files, pick the project and the agent.',
    shot: 'start-task-skill',
    alt: 'The Start a task dialog. Context from An agent skill, skill fetch-ticket, reference NAT-142, and an area to attach files.',
  },
]

const agents = [
  { name: 'Claude Code', cmd: 'claude', how: 'Hooks through its settings file. The only agent that runs a stage as a workflow.', c: 'amber' },
  { name: 'Codex', cmd: 'codex', how: 'Hooks passed on the command line for that run.', c: 'mint' },
  { name: 'Gemini CLI', cmd: 'gemini', how: 'Hooks in a system settings file Natamux points it to.', c: 'sky' },
  { name: 'GitHub Copilot', cmd: 'copilot', how: 'Hooks in the worktree, kept out of git.', c: 'amber' },
  { name: 'Cursor', cmd: 'cursor-agent', how: 'Hooks in the worktree, kept out of git.', c: 'mint' },
  { name: 'Any other CLI', cmd: 'your-agent', how: 'Runs in a plain shell. The terminal bell and natamux ask or done report back.', c: 'sky' },
]

const extras = [
  ['Templates', 'Save a task as a template and start the next one from it.'],
  ['Attachments', 'Drop or paste screenshots, logs and specs on a task. Agents read them in the worktree.'],
  ['Subtasks and order', 'Split a task one level deep, and make a task wait until others are done.'],
  ['More tries', 'Run up to five Claude Code tries of one task and keep the best one.'],
  ['Ports per task', 'Each task gets its own block of ten ports, so dev servers do not collide.'],
  ['Setup script', 'A .natamux-setup script prepares each new worktree: install, seed, copy env.'],
  ['Notifications', 'A system notice when a task needs your input, even with the window in the back.'],
  ['Resume', 'After a restart, agents of running and waiting stages start again where they were.'],
  ['Updates itself', 'On macOS and Linux the app downloads the new version and checks its checksum.'],
  ['Docker', 'Run the daemon and the dashboard on a server or in a codespace, behind a token.'],
]
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Natamux: run coding agents in parallel</title>
    <meta
      name="description"
      content="A free desktop app for Claude Code, Codex, Gemini CLI, GitHub Copilot and Cursor. Each task gets its own git worktree, terminal and checked stages, from spec to pull request, on one dashboard."
    />
    <link rel="canonical" href={`${site}${base}`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}${base}`} />
    <meta property="og:title" content="Natamux: run coding agents in parallel" />
    <meta property="og:description" content="Each task gets its own worktree, terminal and stages. One dashboard shows which task needs you." />
    <meta property="og:image" content={`${site}${base}media/home/og-progress.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="750" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#070c18" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f6fb" media="(prefers-color-scheme: light)" />
    <link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
    <!-- The hero poster is the LCP image. -->
    <link rel="preload" as="image" href={`${base}media/hero-flow-dark.webp`} media="not (prefers-color-scheme: light)" fetchpriority="high" />
    <link rel="preload" as="image" href={`${base}media/hero-flow-light.webp`} media="(prefers-color-scheme: light)" fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wdth,wght@75..100,400..700&family=JetBrains+Mono:wght@400..600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Same key as the docs (Starlight), so the theme carries over.
      try {
        const saved = localStorage.getItem('starlight-theme')
        const light = saved ? saved === 'light' : matchMedia('(prefers-color-scheme: light)').matches
        document.documentElement.dataset.theme = light ? 'light' : 'dark'
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="wrap nav-row">
        <a class="brand" href={base} aria-label="Natamux home">
          <img src={`${base}icon.svg`} alt="" width="28" height="28" />
          <span>Natamux</span>
        </a>
        <nav aria-label="Main">
          <a href="#flow">How it works</a>
          <a href="#views">Dashboard</a>
          <a href="#terminal">Terminal</a>
          <a href="#git">Git</a>
          <a href="#agents">Agents</a>
          <a href={docs}>Docs</a>
        </nav>
        <div class="nav-end">
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch to light theme">
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" /></svg>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.2 8.2 0 1 0 10.6 10.6Z" /></svg>
          </button>
          <a class="icon-btn" href={repo} aria-label="Natamux on GitHub">
            <svg viewBox="0 0 16 16" aria-hidden="true" class="fill"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z" /></svg>
          </a>
          <a class="btn primary small" href="#download">Download</a>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="wrap hero-copy">
          <a class="news" href="#download">Now on macOS, Windows and Linux</a>
          <h1 id="hero-title">
            <span class="line">Run coding agents in parallel.</span>
            <span class="line">Step in only when one needs you.<span class="cursor" aria-hidden="true"></span></span>
          </h1>
          <p class="lede">
            Natamux is a free desktop app for Claude Code, Codex, Gemini CLI, GitHub Copilot and Cursor. Each task
            gets its own git worktree, terminal and checked stages, from spec to pull request. One dashboard shows
            which task waits for you.
          </p>
          <div class="ctas">
            <a class="btn primary big" href={mac} data-hero-download>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M4 20h16" /></svg>
              <span data-hero-label>Download for macOS</span>
            </a>
            <a class="btn big" href={`${docs}getting-started/quick-start/`}>Read the quick start</a>
          </div>
          <p class="fine">
            <span data-hero-note data-version={version}>Version {version} for Apple silicon.</span>{' '}
            <a href="#download">Other systems</a>. MIT licensed, no account.
          </p>
        </div>

        <div class="hero-lanes" aria-hidden="true">
          <svg viewBox="0 0 1200 120" preserveAspectRatio="none">
            <defs>
              <mask id="lanes-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="1200" height="120">
                <rect class="lanes-wipe" width="1200" height="120" fill="#fff" />
              </mask>
            </defs>
            <g mask="url(#lanes-mask)" fill="none" stroke-width="3" stroke-linecap="round">
              <path class="lane-amber" d="M140 0 C 140 70, 600 50, 600 120" vector-effect="non-scaling-stroke" />
              <path class="lane-sky" d="M600 0 V 120" vector-effect="non-scaling-stroke" />
              <path class="lane-mint" d="M1060 0 C 1060 70, 600 50, 600 120" vector-effect="non-scaling-stroke" />
            </g>
          </svg>
        </div>

        <div class="wrap">
          <figure class="hero-shot" data-hero>
            <div class="frame">
              {
                ['dark', 'light'].map((theme) => (
                  <video
                    class={`for-${theme}`}
                    muted
                    loop
                    playsinline
                    preload="none"
                    poster={`${base}media/hero-flow-${theme}.webp`}
                    width="2400"
                    height="1500"
                    aria-label="Screen recording of one task in the Natamux dashboard, from spec approval to a passed review."
                  >
                    <source src={`${base}media/hero-flow-${theme}.mp4`} type="video/mp4" />
                    <source src={`${base}media/hero-flow-${theme}.webm`} type="video/webm" />
                  </video>
                ))
              }
              <button class="btn small hero-play" type="button" data-hero-play hidden>
                <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
                <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12-7.5Z" /></svg>
                <span data-hero-play-label>Play</span>
              </button>
            </div>
            <ol class="hero-steps" aria-hidden="true">
              {heroSteps.map(([at, label]) => <li data-at={at}>{label}</li>)}
            </ol>
            <figcaption class="sr-only">
              You approve the spec. Test spec and Implement start side by side, each agent in its own shell. When both
              are done, a review agent opens in Shell 5, finds a problem and sends the task back to Implement. Implement
              runs again, the second review passes, and the task moves on to Release.
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="section flow" id="flow" aria-labelledby="flow-title">
        <div class="wrap">
          <div class="head">
            <h2 id="flow-title">Three agents on one task, from spec to pull request</h2>
            <p>
              Approve the plan and two agents start side by side: one builds, one writes the test spec without
              looking at the code. Then the review agent you chose reads the diff. When it finds a problem, the task
              goes back to Implement on its own.
            </p>
          </div>

          <div class="flow-box" data-flow>
            <div class="flow-bar">
              <ul class="legend" aria-label="Agents">
                <li class="amber"><i></i>Agent A in Shell 1: Spec, Plan, Implement, tests</li>
                <li class="mint"><i></i>Agent B in Shell 2: Test spec, a new session</li>
                <li class="sky"><i></i>Agent C in Shell 5: Review, any agent you pick</li>
              </ul>
              <button class="btn small" type="button" data-flow-play aria-pressed="false">
                <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
                <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12-7.5Z" /></svg>
                <span data-flow-play-label>Play</span>
              </button>
            </div>

            <div class="flow-map" role="img" aria-label="The default pipeline: Context, Spec, Plan, then Test spec and Implement side by side, then Automated tests, Review and Release. Review can send the task back to Implement.">
              <svg class="edges wide" viewBox="0 0 1100 400" aria-hidden="true">
                {edges.wide.map(([id, , d]) => <path class="edge" data-e={id} d={d} />)}
                {edges.wide.map(([id, lane, d]) => <path class={`lit ${lane}`} data-e={id} d={d} />)}
              </svg>
              <svg class="edges tall" viewBox="0 0 360 710" aria-hidden="true">
                {edges.tall.map(([id, , d]) => <path class="edge" data-e={id} d={d} />)}
                {edges.tall.map(([id, lane, d]) => <path class={`lit ${lane}`} data-e={id} d={d} />)}
              </svg>
              {
                stages.map((s) => (
                  <div
                    class="node"
                    data-n={s.id}
                    data-lane={s.lane}
                    data-s="idle"
                    style={`--x: ${s.x}; --y: ${s.y}; --mx: ${s.mx}; --my: ${s.my}`}
                    aria-hidden="true"
                  >
                    <b>{s.name}</b>
                    <span class="sub">{s.sub}</span>
                    <span class="state">
                      <i class="spin" />
                      <span data-note>&nbsp;</span>
                    </span>
                  </div>
                ))
              }
              <span class="loop-label" aria-hidden="true">Findings go back, at most twice</span>
            </div>

            <ol class="steps">
              {
                steps.map((s, i) => (
                  <li data-step={i}>
                    <button type="button" data-step-go={i}>
                      <span class="num">{i + 1}</span>
                      {s.title}
                    </button>
                    <p>{s.text}</p>
                  </li>
                ))
              }
            </ol>
          </div>

          <div class="proof">
            <div class="proof-col narrow">
              <figure class="reveal">
                <div class="frame">
                  <Shot name="crop-two-agents" crop={{ width: 641, height: 763 }} alt="The Progress panel of a task. Test spec and Implement run side by side. Test spec is in review with an Approve button, Implement is done." />
                </div>
                <figcaption>Test spec and Implement run side by side in one task. You approve the test spec.</figcaption>
              </figure>
            </div>
            <div class="proof-col wide">
              <figure class="reveal">
                <div class="frame">
                  <Shot name="crop-review-agent" crop={{ width: 1600, height: 782 }} alt="Project settings, Stages tab. The pipeline chart and the stage list, with the Review stage selected and its Agent set to Codex." />
                </div>
                <figcaption>Pick the review agent in <b>Project settings → Stages → Review → Agent</b>. It is saved in <code>.natamux.json</code>, so the team shares it.</figcaption>
              </figure>
              <figure class="reveal side">
                <div class="frame">
                  <Shot name="crop-sent-back" crop={{ width: 641, height: 352 }} alt="The Implement stage running for the second time, with the note Sent back 1×." />
                </div>
                <figcaption>
                  The review agent sent the task back once, so Implement runs again. Then the tests and Review run
                  again. <a href={`${base}media/home/review-loop-dark.webm`}>Watch a 20-second recording</a> of the loop in the app.
                </figcaption>
              </figure>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="views" aria-labelledby="views-title">
        <div class="wrap">
          <div class="head">
            <h2 id="views-title">See every task, and the one that needs you</h2>
            <p>
              The sidebar sizes each task by how much it needs you. A question or a failure gets a tinted card
              with <b>Answer</b>. A running task shows its stage. Finished work folds to one line. The amber pill in the
              title bar counts what waits.
            </p>
          </div>
          <div class="views" data-tabs>
            <div class="views-tabs" role="tablist" aria-label="Dashboard views" aria-orientation="vertical">
              {
                views.map((v, i) => (
                  <button
                    type="button"
                    role="tab"
                    id={`tab-${v.id}`}
                    aria-controls={`panel-${v.id}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                  >
                    <b>{v.name}</b>
                    <span>{v.text}</span>
                  </button>
                ))
              }
            </div>
            <div class="views-panels stack">
              {
                views.map((v, i) => (
                  <div class="views-panel" role="tabpanel" id={`panel-${v.id}`} aria-labelledby={`tab-${v.id}`} data-active={i === 0 ? 'true' : 'false'} inert={i !== 0}>
                    <div class="frame">
                      <Shot name={v.shot} alt={v.alt} sizes="(min-width: 1240px) 820px, 100vw" />
                    </div>
                    <p class="views-cap">{v.text}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="section split" id="terminal" aria-labelledby="terminal-title">
        <div class="wrap split-row">
          <div class="head">
            <h2 id="terminal-title">Real terminals for every agent</h2>
            <p>
              Each task has its own shells. Shell 1 runs the agent; open up to six. The <b>Agents</b> view puts the
              live terminals of up to six tasks in one grid, and a pane that waits for you says so in its header.
            </p>
            <ul class="ticks">
              <li>Drawn on the GPU in JetBrains Mono, with Nerd Font icons and up to 10,000 lines of history</li>
              <li>The pane header shows the agent and what it does now</li>
              <li>Find with match case or a regular expression</li>
              <li>Reconnects by itself, and agents resume after a restart</li>
              <li>Pick the terminal font, or let the desktop app read your Ghostty font</li>
            </ul>
            <p class="more"><a href={`${docs}guides/terminal/`}>Terminal guide</a></p>
          </div>
          <figure class="frame reveal">
            <Shot name="agents" sizes="(min-width: 1240px) 720px, 100vw" alt="The Agents view: four live Claude Code terminals in a grid. The pane at the bottom right asks a question." />
          </figure>
        </div>
      </section>

      <section class="section split flip" id="git" aria-labelledby="git-title">
        <div class="wrap split-row">
          <div class="head">
            <h2 id="git-title">Git and GitHub without leaving the task</h2>
            <p>
              Every task works in its own worktree on its own branch, so agents never touch each other's files or
              your checkout.
            </p>
            <ul class="ticks">
              <li><b>Generate</b> asks the task's agent for a commit message from the diff. Then <b>Commit all</b>.</li>
              <li>Side-by-side diffs, image diffs, and a comment on any line that goes straight to the agent</li>
              <li><b>Push</b>, then <b>Create pull request</b> with the GitHub CLI. The body ends with <code>Closes #N</code></li>
              <li>Natamux watches the PR checks; a merged PR finishes the task</li>
              <li><b>Check on CI</b> pushes a stage's work to a <code>natamux-ci/</code> branch, and a failed run goes back to the agent</li>
              <li><b>Import issues</b> turns open GitHub issues into tasks</li>
            </ul>
            <p class="more"><a href={`${docs}guides/github/`}>GitHub guide</a></p>
          </div>
          <div class="git-shots reveal">
            <figure class="frame back">
              <Shot name="history" sizes="(min-width: 1240px) 600px, 100vw" alt="The History tab: a commit graph of the task branch, 2 commits ahead of main and 2 behind." />
            </figure>
            <figure class="frame front">
              <Shot name="changes-generate" sizes="(min-width: 1240px) 600px, 100vw" alt="The Changes tab: two changed files, a side-by-side diff, and a commit message written by Generate above the Commit all button." />
            </figure>
          </div>
        </div>
      </section>

      <section class="section" id="agents" aria-labelledby="agents-title">
        <div class="wrap">
          <div class="head">
            <h2 id="agents-title">Bring the agents you already use</h2>
            <p>
              Natamux starts five agents for you and adds hooks to each session, so the dashboard knows within a
              second who works, who asks and who is done. Each worktree is trusted for the agent it starts.
            </p>
          </div>
          <ul class="agent-list">
            {
              agents.map((a) => (
                <li class={a.c}>
                  <b>{a.name}</b>
                  <code>{a.cmd}</code>
                  <span>{a.how}</span>
                </li>
              ))
            }
          </ul>
          <p class="more"><a href={`${docs}concepts/agents-and-hooks/`}>Agents and hooks</a></p>
        </div>
      </section>

      <section class="section split" id="cli" aria-labelledby="cli-title">
        <div class="wrap split-row">
          <div class="head">
            <h2 id="cli-title">One command for you and your agents</h2>
            <p>
              <code>natamux</code>, or <code>nmx</code> for short. Create and start tasks from your own shell.
              Agents use the same command to ask you something, say a stage is done, or send the work back.
            </p>
            <p class="more"><a href={`${docs}reference/cli/`}>CLI reference</a></p>
          </div>
          <div class="term" role="img" aria-label="Terminal commands: you create a task and start Codex on it; the agent asks a question and reports done; the review agent sends the task back with a reason.">
            <div class="term-bar"><i></i><i></i><i></i></div>
            <pre><span class="c"># You, in any shell</span>
<span class="p">$</span> nmx task create "Export the report as CSV" --label reports
<span class="p">$</span> nmx agent start T-0010 --agent codex

<span class="c"># The agent, in its task terminal</span>
<span class="p">$</span> natamux ask "Keep the old CSV columns, or drop them?"
<span class="p">$</span> natamux done

<span class="c"># The review agent, when something must change</span>
<span class="p">$</span> natamux stage back $NATAMUX_TASK_ID \
    --reason "Empty rows break the export"</pre>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="extras-title">
        <div class="wrap">
          <div class="head">
            <h2 id="extras-title">The small things, done</h2>
          </div>
          <dl class="extras">
            {
              extras.map(([t, d]) => (
                <div>
                  <dt>{t}</dt>
                  <dd>{d}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <section class="section privacy" aria-labelledby="privacy-title">
        <div class="wrap privacy-row">
          <h2 id="privacy-title">Your code stays on your machine</h2>
          <ul>
            <li><b>No account, no telemetry.</b> Besides the update check, it talks to GitHub only through your own <code>git</code> and <code>gh</code>, for example to follow your pull requests and CI.</li>
            <li><b>Local daemon.</b> It listens on 127.0.0.1 and wants a token on every request.</li>
            <li><b>Open source.</b> MIT licensed. Your agents and the GitHub CLI use their own sign-in.</li>
          </ul>
        </div>
      </section>

      <section class="section download" id="download" aria-labelledby="download-title">
        <div class="wrap">
          <div class="head">
            <h2 id="download-title">Download Natamux {version}</h2>
            <p>
              You need git and at least one agent, installed and signed in. The GitHub CLI adds pull requests and
              issues.
            </p>
          </div>

          <div class="dl" data-tabs data-dl>
            <div class="dl-tabs" role="tablist" aria-label="Operating system">
              <button type="button" role="tab" id="tab-mac" aria-controls="panel-mac" aria-selected="true" tabindex="0">macOS</button>
              <button type="button" role="tab" id="tab-win" aria-controls="panel-win" aria-selected="false" tabindex="-1">Windows</button>
              <button type="button" role="tab" id="tab-linux" aria-controls="panel-linux" aria-selected="false" tabindex="-1">Linux</button>
            </div>
            <p class="dl-detect" data-dl-detect hidden></p>
            <div class="stack">
              <div class="dl-panel" role="tabpanel" id="panel-mac" aria-labelledby="tab-mac" data-active="true">
                <div class="dl-buttons">
                  <a class="btn primary big" href={mac} data-arch="arm64">Download for Apple silicon</a>
                  <a class="btn big" href={latest('Natamux-mac-x64.dmg')} data-arch="x64">Download for Intel</a>
                </div>
                <ol class="dl-steps">
                  <li>Open the <code>.dmg</code> and drag Natamux to Applications.</li>
                  <li>The app is not signed yet, so macOS blocks the first start. Open <b>System Settings → Privacy &amp; Security</b> and click <b>Open Anyway</b>. Or run:</li>
                </ol>
                <div class="cmd"><code>xattr -dr com.apple.quarantine /Applications/Natamux.app</code><button type="button" data-copy>Copy</button></div>
              </div>
              <div class="dl-panel" role="tabpanel" id="panel-win" aria-labelledby="tab-win" data-active="false" inert>
                <div class="dl-buttons">
                  <a class="btn primary big" href={latest('Natamux-win-x64.exe')}>Download for Windows</a>
                </div>
                <ol class="dl-steps">
                  <li>Run <code>Natamux-win-x64.exe</code>. It needs no administrator rights.</li>
                  <li>The installer is not signed yet. If SmartScreen says <b>Windows protected your PC</b>, click <b>More info</b>, then <b>Run anyway</b>.</li>
                  <li>Task terminals run PowerShell. For a new version, run the new installer; it keeps your data.</li>
                </ol>
              </div>
              <div class="dl-panel" role="tabpanel" id="panel-linux" aria-labelledby="tab-linux" data-active="false" inert>
                <div class="dl-buttons">
                  <a class="btn primary big" href={latest('Natamux-linux-x86_64.AppImage')}>Download AppImage</a>
                  <a class="btn big" href={latest('Natamux-linux-amd64.deb')}>Download .deb</a>
                </div>
                <ol class="dl-steps">
                  <li>AppImage: make it executable, then start it. On Ubuntu 24.04 and later, add <code>--no-sandbox</code> if it does not start, or use the <code>.deb</code>.</li>
                  <li>Debian and Ubuntu: install the <code>.deb</code> with apt. The app is <code>natamux-desktop</code>.</li>
                </ol>
                <div class="cmd"><code>sudo apt install ./Natamux-linux-amd64.deb</code><button type="button" data-copy>Copy</button></div>
              </div>
            </div>
          </div>

          <div class="dl-all">
            <table>
              <caption>Every file of version {version}</caption>
              <thead><tr><th scope="col">System</th><th scope="col">File</th></tr></thead>
              <tbody>
                {
                  files.map((f) => (
                    <tr>
                      <td>{f.label}</td>
                      <td><a href={latest(f.file)}>{f.file}</a></td>
                    </tr>
                  ))
                }
                <tr>
                  <td>Checksums of every file</td>
                  <td><a href={latest('SHA256SUMS.txt')}>SHA256SUMS.txt</a></td>
                </tr>
              </tbody>
            </table>
            <ul class="dl-links">
              <li><a href={`${docs}getting-started/install/`}>Install guide</a>, with checks and the command line in your shell</li>
              <li><a href={`${repo}/releases/tag/v${version}`}>Release notes of {version}</a> and <a href={`${docs}help/changelog/`}>the changelog</a></li>
              <li><a href={`${docs}guides/self-host-docker/`}>Run with Docker</a> or from source with <code>scripts/dev.sh up</code></li>
            </ul>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-row">
        <a class="brand" href={base} aria-label="Natamux home"><img src={`${base}icon.svg`} alt="" width="22" height="22" /><span>Natamux</span></a>
        <p>MIT licensed. Made for people who run more than one agent.</p>
        <nav aria-label="Footer">
          <a href={docs}>Docs</a>
          <a href={`${docs}help/changelog/`}>Changelog</a>
          <a href={`${repo}/releases`}>Releases</a>
          <a href={`${repo}/blob/main/SECURITY.md`}>Security</a>
          <a href={`${repo}/blob/main/PRIVACY.md`}>Privacy</a>
          <a href={repo}>GitHub</a>
        </nav>
      </div>
    </footer>

    <script>
      import '../scripts/landing.js'
    </script>
  </body>
</html>
