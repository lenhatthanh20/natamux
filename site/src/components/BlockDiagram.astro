---
// A small diagram of one building block. The markup is the final state; landing.css plays it from
// the start each time its tab opens (class d draws a line, in fades in, dim fades out, by --d).
interface Props {
  kind: 'gate' | 'side' | 'branch' | 'back' | 'ci' | 'agents'
  label: string
}
const { kind, label } = Astro.props
const agents = [
  ['Reproduce', 'Cursor'],
  ['Implement', 'Claude Code'],
  ['Test spec', 'Gemini CLI'],
  ['Review', 'Codex'],
]
---

<svg class="md" viewBox="0 0 360 130" role="img" aria-label={label}>
  {
    kind === 'gate' && (
      <>
        <rect class="md-n" x="20" y="30" width="120" height="44" rx="9" />
        <rect class="md-on amber in" style="--d: 0.2s" x="20" y="30" width="120" height="44" rx="9" />
        <rect class="md-on mint in" style="--d: 1.4s" x="20" y="30" width="120" height="44" rx="9" />
        <text class="md-t" x="80" y="52">Spec</text>
        <g class="md-gate" transform="translate(122 36)">
          <circle cx="6" cy="3.8" r="2.3" />
          <path d="M1.8 11.2a4.2 4.2 0 0 1 8.4 0" />
        </g>
        <g class="in" style="--d: 0.6s">
          <rect class="md-pill" x="45" y="86" width="70" height="24" rx="12" />
          <text class="md-pill-t" x="80" y="98">Approve</text>
        </g>
        <path class="md-w" d="M140 52 H220" />
        <path class="md-d mint d" style="--d: 1.6s" pathLength="1" d="M140 52 H220" />
        <rect class="md-n" x="220" y="30" width="120" height="44" rx="9" />
        <rect class="md-on sky in" style="--d: 2.3s" x="220" y="30" width="120" height="44" rx="9" />
        <text class="md-t" x="280" y="52">Implement</text>
      </>
    )
  }
  {
    kind === 'side' && (
      <>
        <rect class="md-group" x="122" y="3" width="120" height="124" rx="12" />
        <text class="md-s" x="182" y="65">Side by side</text>
        <path class="md-w" d="M84 65 C107 65, 107 26, 130 26" />
        <path class="md-w" d="M84 65 C107 65, 107 104, 130 104" />
        <path class="md-w" d="M234 26 C255 26, 255 65, 276 65" />
        <path class="md-w" d="M234 104 C255 104, 255 65, 276 65" />
        <path class="md-d sky d" style="--d: 0.2s" pathLength="1" d="M84 65 C107 65, 107 26, 130 26" />
        <path class="md-d sky d" style="--d: 0.2s" pathLength="1" d="M84 65 C107 65, 107 104, 130 104" />
        <path class="md-d mint d" style="--d: 2s" pathLength="1" d="M234 26 C255 26, 255 65, 276 65" />
        <path class="md-d mint d" style="--d: 2s" pathLength="1" d="M234 104 C255 104, 255 65, 276 65" />
        <rect class="md-n" x="8" y="50" width="76" height="30" rx="8" />
        <text class="md-t" x="46" y="65">Plan</text>
        <rect class="md-n" x="130" y="10" width="104" height="32" rx="8" />
        <rect class="md-n" x="130" y="88" width="104" height="32" rx="8" />
        <rect class="md-on sky in" style="--d: 0.9s" x="130" y="10" width="104" height="32" rx="8" />
        <rect class="md-on sky in" style="--d: 0.9s" x="130" y="88" width="104" height="32" rx="8" />
        <rect class="md-on mint in" style="--d: 1.9s" x="130" y="10" width="104" height="32" rx="8" />
        <rect class="md-on mint in" style="--d: 1.9s" x="130" y="88" width="104" height="32" rx="8" />
        <text class="md-t" x="182" y="26">Test spec</text>
        <text class="md-t" x="182" y="104">Implement</text>
        <rect class="md-n" x="276" y="50" width="76" height="30" rx="8" />
        <rect class="md-on sky in" style="--d: 2.6s" x="276" y="50" width="76" height="30" rx="8" />
        <text class="md-t" x="314" y="65">Review</text>
      </>
    )
  }
  {
    kind === 'branch' && (
      <>
        <path class="md-w" d="M78 65 C110 65, 115 26, 150 26" />
        <path class="md-d mint d" style="--d: 0.6s" pathLength="1" d="M78 65 C110 65, 115 26, 150 26" />
        <rect class="md-diamond" x="44" y="49" width="32" height="32" rx="5" transform="rotate(45 60 65)" />
        <rect class="md-on md-diamond-on sky in" style="--d: 0.1s" x="44" y="49" width="32" height="32" rx="5" transform="rotate(45 60 65)" />
        <text class="md-t" x="60" y="65">If</text>
        <rect class="md-n" x="150" y="10" width="120" height="32" rx="8" />
        <rect class="md-on mint in" style="--d: 1.2s" x="150" y="10" width="120" height="32" rx="8" />
        <text class="md-t" x="210" y="26">Bug fix</text>
        <text class="md-s start mint-t in" style="--d: 1.3s" x="282" y="26">Taken</text>
        <g class="dim" style="--d: 1.2s">
          <path class="md-w dash" d="M78 65 C110 65, 115 104, 150 104" />
          <rect class="md-n" x="150" y="88" width="120" height="32" rx="8" />
          <text class="md-t" x="210" y="104">Feature</text>
        </g>
        <text class="md-s start in" style="--d: 1.4s" x="282" y="104">Not taken</text>
      </>
    )
  }
  {
    kind === 'back' && (
      <>
        <path class="md-w" d="M140 40 H220" />
        <path class="md-d sky d" style="--d: 0.1s" pathLength="1" d="M140 40 H220" />
        <rect class="md-n" x="20" y="20" width="120" height="40" rx="9" />
        <rect class="md-on sky in" style="--d: 2.4s" x="20" y="20" width="120" height="40" rx="9" />
        <text class="md-t" x="72" y="40">Implement</text>
        <text class="md-x in" style="--d: 2.4s" x="124" y="40">×2</text>
        <rect class="md-n" x="220" y="20" width="120" height="40" rx="9" />
        <rect class="md-on sky in" style="--d: 0.7s" x="220" y="20" width="120" height="40" rx="9" />
        <rect class="md-on rose in" style="--d: 1.4s" x="220" y="20" width="120" height="40" rx="9" />
        <text class="md-t" x="280" y="40">Review</text>
        <path class="md-d rose d" style="--d: 1.6s" pathLength="1" d="M280 60 C280 118, 80 118, 80 60" />
        <path class="md-arrow rose in" style="--d: 2.3s" d="M74 70 L80 61 L86 70" />
        <text class="md-s rose-t in" style="--d: 1.9s" x="180" y="122">Sent back with the reason</text>
      </>
    )
  }
  {
    kind === 'ci' && (
      <>
        <path class="md-w" d="M120 44 H160" />
        <path class="md-d sky d" style="--d: 0.1s" pathLength="1" d="M120 44 H160" />
        <rect class="md-n" x="10" y="24" width="110" height="40" rx="9" />
        <rect class="md-on sky in" style="--d: 2s" x="10" y="24" width="110" height="40" rx="9" />
        <text class="md-t" x="65" y="44">Implement</text>
        <rect class="md-n" x="160" y="24" width="150" height="40" rx="9" />
        <rect class="md-on rose in" style="--d: 0.9s" x="160" y="24" width="150" height="40" rx="9" />
        <rect class="md-on mint in" style="--d: 2.8s" x="160" y="24" width="150" height="40" rx="9" />
        <text class="md-m" x="235" y="44">natamux-ci/&lt;branch&gt;</text>
        <path class="md-d rose d" style="--d: 1.2s" pathLength="1" d="M235 64 C235 118, 65 118, 65 64" />
        <path class="md-arrow rose in" style="--d: 1.8s" d="M59 74 L65 65 L71 74" />
        <text class="md-s rose-t in" style="--d: 1.6s" x="150" y="122">A red run sends the failed log</text>
        <path class="md-d mint d check" style="--d: 3s" pathLength="1" d="M322 44 l6 6 l11 -12" />
      </>
    )
  }
  {
    kind === 'agents' &&
      agents.map(([stage, agent], i) => (
        <>
          {i > 0 && <path class="md-w" d={`M${i * 93 - 13} 63 H${i * 93}`} />}
          <rect class="md-n" x={i * 93} y="35" width="80" height="56" rx="9" />
          <rect class="md-on sky in" style={`--d: ${0.2 + i * 0.6}s`} x={i * 93} y="35" width="80" height="56" rx="9" />
          {i < 3 && <rect class="md-on mint in" style={`--d: ${0.8 + i * 0.6}s`} x={i * 93} y="35" width="80" height="56" rx="9" />}
          <text class="md-t" x={i * 93 + 40} y="56">{stage}</text>
          <text class="md-s sky-t" x={i * 93 + 40} y="74">{agent}</text>
        </>
      ))
  }
</svg>
