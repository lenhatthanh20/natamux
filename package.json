{
  "name": "natamux",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "lint": "biome check packages e2e && pnpm -r --if-present run typecheck",
    "format": "biome check --write packages e2e",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present run test --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@vitest/coverage-v8": "^5.0.4"
  }
}
