    "original": "import { total, type Item } from './cart.js'\n\nexport function checkout(items: Item[], coupon = 0) {\n  return total(items) - coupon\n}\n\nexport const roundMoney = (value: number) => Math.round(value * 100) / 100\n",
    "modified": "import { total, type Item } from './cart.js'\n\n// A coupon can take the total down to zero, never below it.\nexport function checkout(items: Item[], coupon = 0) {\n  const amount = total(items) - Math.max(0, coupon)\n  return Math.max(0, amount)\n}\n\nexport const roundMoney = (value: number) => Math.round(value * 100) / 100\n"
