 import { total, type Item } from './cart.js'

+// A coupon can take the total down to zero, never below it.
 export function checkout(items: Item[], coupon = 0) {
-  return total(items) - coupon
+  const amount = total(items) - Math.max(0, coupon)
+  return Math.max(0, amount)
 }

 export const roundMoney = (value: number) => Math.round(value * 100) / 100
