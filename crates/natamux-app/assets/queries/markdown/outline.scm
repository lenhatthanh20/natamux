; Natamux outline patterns. Worked out from the old editor output (golden files T-OUT-1)
; and node names as the author remembers them; no grammar file was at hand.

(section
  (atx_heading
    [
      (atx_h1_marker)
      (atx_h2_marker)
      (atx_h3_marker)
      (atx_h4_marker)
      (atx_h5_marker)
      (atx_h6_marker)
    ] @context
    heading_content: (_) @name)) @item
