{
  "name": "@natamux/desktop",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "rebuild-native": "electron-rebuild --force --only node-pty --module-dir ../daemon"
  },
  "dependencies": {
    "@natamux/cli": "workspace:*",
    "@natamux/daemon": "workspace:*"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@natamux/web": "workspace:*",
    "@types/node": "^22.20.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "description": "Run many coding agents in parallel, one dashboard for every task",
  "author": "lenhatthanh20",
  "homepage": "https://natamux.github.io/",
  "license": "MIT"
