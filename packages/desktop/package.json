{
  "name": "@helmsman/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "rebuild-native": "electron-rebuild --force --only node-pty --module-dir ../daemon"
  },
  "dependencies": {
    "@helmsman/cli": "workspace:*",
    "@helmsman/daemon": "workspace:*",
    "@helmsman/web": "workspace:*"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^26.6.4",
    "electron": "^44.7.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "description": "Helmsman desktop app",
  "author": "Helmsman"
}
