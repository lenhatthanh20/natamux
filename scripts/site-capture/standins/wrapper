#!/usr/local/bin/node
// Runs the bash stand-in under node, as the real agent CLIs run, so Natamux sees this program
// (node /data/bin/<agent>) as that agent and not as a plain shell.
const { spawn } = require('node:child_process')
const name = require('node:path').basename(process.argv[1])
const child = spawn('/bin/bash', ['/data/bin/agent', ...process.argv.slice(2)], {
  stdio: 'inherit',
  env: { ...process.env, STANDIN_NAME: name },
})
for (const signal of ['SIGHUP', 'SIGTERM', 'SIGINT']) process.on(signal, () => child.kill(signal))
child.on('exit', (code) => process.exit(code ?? 0))
